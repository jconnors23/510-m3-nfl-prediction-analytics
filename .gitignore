# Local working files. These stay on your machine and are never committed.
local/
local-docs/
specs/
.cursor/
.kiro/

# The built documentation site. `mkdocs build` recreates it from docs/.
site/

# Python files that are made automatically when code runs. They are recreated every time.
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
build/
dist/
*.egg-info/

# Front-end tooling: the installed JavaScript libraries (Phase 5).
node_modules/

# Virtual environments: the private folder of installed Python packages.
.venv/
venv/
env/

# Outputs of training. Running `python -m src.model.train` recreates them.
# mlruns/ and wandb/ are the folders other tracking tools would create.
mlruns/
wandb/
# The saved trained model.
models/
# MLflow's run record (settings and scores) and each run's files.
mlflow.db
mlartifacts/

# Secrets. Keys and passwords must never be committed.
.env
*.pem
credentials.json

# Files the Mac adds to folders.
.DS_Store
